# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_CSV_URL: Optional public read-only Published Google Sheets CSV URL
# or Google Apps Script Web App JSON endpoint URL.
# Example CSV: https://docs.google.com/spreadsheets/d/e/<PUBLISHED_ID>/pub?gid=0&single=true&output=csv
# When unset, the server reads the initial migrated dataset from public/data/packages.csv.
GOOGLE_SHEETS_CSV_URL=""

# VITE_SHEETS_REFRESH_SECONDS: Polling interval in seconds for reading published package updates.
VITE_SHEETS_REFRESH_SECONDS="30"
